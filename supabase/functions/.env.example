# Secretos de la Edge Function `inventory-alerts`. Copia a supabase/functions/.env (ignorado por git)
# para `supabase functions serve --env-file`, o en producción:
#   supabase secrets set --env-file ./supabase/functions/.env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase; no se definen aquí.

# Secreto compartido con pg_cron (cabecera x-cron-secret). Genera uno largo y aleatorio.
CRON_SECRET=
# Clave de la API de Resend.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. TADUKA <alertas@tu-dominio.com>
EMAIL_FROM=
# URL pública de la app, para los enlaces del correo (sin barra final).
APP_URL=http://127.0.0.1:3000
# SOLO pruebas locales con supabase/dev-tools/mock-resend.mjs; vacío en producción.
# Solo se aceptan https://api.resend.com/emails, http://localhost, http://127.0.0.1 y
# http://host.docker.internal (desde el contenedor, localhost NO es el equipo anfitrión).
RESEND_API_URL=
